// internal/adapters/http_cache.go
package adapters

import "context"

type ErrNilHTTPCacheClient struct{}

func (e *ErrNilHTTPCacheClient) Error() string {
	return "error nil client in HTTPCacheAdapter"
}

type HTTPCacheClient interface {
	Close() error
}

type HTTPCacheOpt func(a *HTTPCacheAdapter) error

// WithHTTPCacheClient sets the adapter's client
func WithHTTPCacheClient(client HTTPCacheClient) HTTPCacheOpt {
	return func(a *HTTPCacheAdapter) error {
		a.client = client

		return nil
	}
}

type HTTPCacheAdapter struct {
	client HTTPCacheClient
}

// NewHTTPCacheAdapter creates a new HTTPCacheAdapter
func NewHTTPCacheAdapter(opts ...HTTPCacheOpt) (*HTTPCacheAdapter, error) {
	adapter := &HTTPCacheAdapter{}

	for _, opt := range opts {
		if err := opt(adapter); err != nil {
			return nil, err
		}
	}

	return adapter, nil
}

// Do is an example of the adapter's operations. Replace it with the
// methods this adapter actually exposes
func (a *HTTPCacheAdapter) Do(ctx context.Context) error {
	if a.client == nil {
		return &ErrNilHTTPCacheClient{}
	}

	return nil
}

// Close closes the underlying client
func (a *HTTPCacheAdapter) Close() error {
	if a.client == nil {
		return nil
	}

	return a.client.Close()
}
