// internal/adapters/events.go
package adapters

import (
	"bytes"
	"context"
	"io"
	"os/exec"
)

type EventsAdapter struct{}

func NewEventsAdapter() *EventsAdapter {
	return &EventsAdapter{}
}

func (a *EventsAdapter) Exec(ctx context.Context, cmd *exec.Cmd) (io.Reader, error) {
	output, err := cmd.CombinedOutput()
	if err != nil {
		return nil, err
	}

	return bytes.NewReader(output), nil
}
